    <script type="text/javascript">

        function delete_task(id) 
        {

            fetch
            (
                '../php/actions/del.php', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) }

            ).then( (response) => 
            {

                if (!response.ok) 
                {

                    console.error('Task Deletion Failure - DELETE HTTP Request Failed'); alert('Failed to delete Task'); return;

                }

                return response.json();

            }).then( (data) => 
            {   

                if (!data.status) { alert(data.error); return; }

                alert('Successfully deleted Task');

                window.location.reload();

            }).catch( (error) => 
            {

                console.error(error.message);

                alert('Failed to delete Task');

            });

        }

        function switch_task_status(task_id) 
        {

            fetch
            (
                '../php/actions/status.php', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: task_id }) }

            ).then( (response) => 
            {

                if (!response.ok) 
                {

                    console.error('Task Status Switching Failure - PUT HTTP Request Failure'); alert('Failed to switch Task Status'); return;

                }

                return response.json();

            }).then( (data) => 
            {

                if (data.status == false) { alert(data.error); return; }

                alert('New Status');

                window.location.reload();

            }).catch( (error) => 
            {

                console.error(error.message);

                alert('Failed to switch Task Status');

            });

        }

    </script>
    
